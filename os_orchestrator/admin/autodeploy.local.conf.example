# git_autodeploy local config -- copy to autodeploy.local.conf (gitignored) and edit.
# The auto-deploy is SHADOW by default even without this file, so it only OBSERVES: it
# detects a moved origin/main and logs/alerts what it would do, applying nothing.
#
# AUTODEPLOY_MODE:
#   off    -- do nothing at all.
#   shadow -- (default) detect + log + alert what it WOULD deploy; apply nothing.
#   on     -- pull the clean fast-forward and restart the fleet (binance.service). No reboot,
#             PIA untouched. role=bot processes reload on their next supervise cycle.
AUTODEPLOY_MODE=shadow

# Branch to track (default main).
#AUTODEPLOY_BRANCH=main

# Min seconds between fleet restarts for the SAME target commit, in `on` mode (default 900).
#AUTODEPLOY_COOLDOWN=900
