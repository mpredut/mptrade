# ============================================================================
# Hyperliquid — a VERSIONED config (it IS committed). The secrets (wallet keys) live in .env.
# The bot loads .env first (secrets and local overrides win), then this file.
# ============================================================================
HL_MAINNET=true              # true = mainnet (bani reali), false = testnet

# ============================================================================
# Instrument (PERP long-only)
# ============================================================================
HL_COIN=HYPE                 # moneda perp (HYPE, BTC, ETH, ...)
HL_LEVERAGE=1                # Leverage (1 = quasi-spot, liquidation very far away).
HL_POLL_SECONDS=60           # directional bot polling interval
HL_DIRECTION=long            # long (profit when it rises) | short (profit when it FALLS) — hl_bot.py only
SYMBOL_LABEL=Hyperliquid HYPE

# ============================================================================
# Strategie DCA + take-profit (sumele in USDC, colateralul Hyperliquid)
# ============================================================================
STRAT_EXECUTE=true           # false = PAPER; true = BANI REALI. --paper forteaza PAPER.
STRATEGY_MODE=avg_tp         # avg_tp or dca_only
STRAT_CURRENCY=USDC
STRAT_ENTRY=350              # 8 Sep: 1000->350. Right-sized to the real HL capital (~1107 USDC), not the old x20 profile.
STRAT_ENTRY_DISCOUNT_PCT=0.2 # Buy (long) at market minus this %.
STRAT_DCA=100                # 8 Sep: 600->100. Requests may be resized to known funds/budget; venue fee/minimum checks still apply.
STRAT_DCA_DROP_PCT=2.0       # Buy more on a fall of this %.
STRAT_TAKEPROFIT_PCT=5.0     # 21 Aug: 0.5->5.0. Long-term A: above +5%% the trailing starts (ride), not a scalp
STRAT_CHECK_MINUTES=1        # How often, in minutes, the price is checked.
STRAT_MAX_BUDGET=1050        # 8 Sep: 10000->1050. Hard cap = real capital minus a buffer (350 + 7x100).
STRAT_MAX_DCA_BUYS=7         # 8 Sep: 10->7 (350 + 7x100 = 1050 = MAX_BUDGET)
STRAT_ORDER_TTL_MIN=10
STRAT_STOP_LOSS_PCT=20       # 8 Sep: 7->20. Wider loss trigger, not a guaranteed loss cap; not promoted by the 9 Sep review. 0 = off.
STRAT_REENTRY_TOLERANCE_PCT=0.05
HL_FEE_PCT=0.035             # legacy PERP/DN estimate; spot_dca uses the real fees from the fills

# --- The trend/prediction signal (only for the DIRECTIONAL strategy hl_bot.py) ---
HL_SIGNAL_GATE=false         # true = enter ONLY if the signal favours the direction
SIGNAL_SOURCE=off            # off | builtin (trend from candles) | file (your model writes signal.json)
SIGNAL_FILE=signal.json      # the file your LSTM/price analysis writes
SIGNAL_FAST_H=12             # media rapida (ore) pt trend-ul builtin
SIGNAL_SLOW_H=48             # media lenta (ore)
SIGNAL_BAND_PCT=0.3          # The neutral zone: a difference under this % = neutral.
SIGNAL_MAX_AGE_MIN=60        # if the signal in the file is older than this -> neutral

# ============================================================================
# DELTA-NEUTRAL (dn_bot.py) — funding farming, market-neutral, SIGUR
# ============================================================================
HL_SPOT_PAIR=                # EMPTY = resolved AUTOMATICALLY from HL_SPOT_TOKEN (HYPE -> @107).
HL_SPOT_TOKEN=HYPE           # implicit = HL_COIN; schimbi moneda dintr-un singur loc
DN_NOTIONAL=400              # USDC per leg (4x the funding income, the same risk profile).
                             # With DN_ALLOW_SCALE_UP=true, the bot grows the LIVE position up to here
                             # automatically (in 1-2 ticks, with a collateral guard). Liquidation at +800%.
# regula inteligenta de funding (anti-churn): mediere + histerezis + timp minim
DN_ENTRY_FUNDING_HR_PCT=0.0   # Open when the AVERAGE funding is >= this.
DN_EXIT_FUNDING_HR_PCT=-0.005 # close ONLY when AVERAGE funding < this (negative -> no churn)
DN_FUNDING_WINDOW_H=4         # mediaza funding-ul pe atatea ore (ignora citiri izolate)
DN_MIN_HOLD_H=6               # Do not close sooner than this many hours.
DN_CHECK_MINUTES=2           # How often, in minutes, it checks.
DN_REBALANCE_PCT=5           # Rebalance at this % of delta.
DN_LIQ_ALERT_PCT=20          # alert + auto-reduce when the price is this % from liquidation
DN_AUTO_PROTECT=true         # Automatically reduce the position if liquidation approaches.
DN_REDUCE_PCT=25             # By what % it reduces on each intervention.
DN_PERP_LEVERAGE=1           # levier short (1 = lichidare ~+100%, cel mai sigur)
DN_ALLOW_SCALE_UP=true        # Grow the live position to DN_NOTIONAL (with a collateral guard).

# --- LONG-TERM trend-ride strategy (A_trail) — 21 Aug 2026 ---
STRAT_TP_TREND_HOLD=true       # Above TP, ride the trend and exit on a pullback instead of a fixed price.
STRAT_TP_REGIME_GATE=false     # Preserve live behavior until regime-gated TP is validated.
STRAT_TP_TRAIL_ADAPTIVE=true   # A: trailing = k×vol_1h, wider in high volatility.
STRAT_TP_TRAIL_K=2.0
STRAT_TP_TRAIL_MIN=1.5         # The lower clamp (%) — do not exit on noise.
STRAT_TP_TRAIL_MAX=8.0         # The upper clamp (%) — do not let the profit run away.
HL_LIVE_ORDERS=true            # Enabled 21 Aug: real-money Hyperliquid orders.

# Explicit shared-engine policy. Zero/false values intentionally disable features.
STRAT_TOTAL_BUDGET=0
STRAT_ALLOC_PCT=0
STRAT_ENTRY_PCT=0
STRAT_DCA_PCT=0
STRAT_ADOPT_COST=0
STRAT_ADOPT_QTY=0
# Hybrid re-entry: buys dynamic dip in confirmed trend (reentry_pullback_adaptive),
# while preserving 2.0% defensive discount in chop/bear (reentry_drop_pct).
STRAT_REENTRY_DROP_PCT=2.0
STRAT_REENTRY_HYBRID_ENABLED=true
STRAT_REENTRY_PULLBACK_ADAPTIVE=true
STRAT_REENTRY_PULLBACK_K=1.0
STRAT_REENTRY_PULLBACK_MIN=0.8
STRAT_REENTRY_PULLBACK_MAX=3.5
STRAT_REENTRY_TTL_HOURS=48.0
STRAT_REENTRY_ADAPTIVE=false
STRAT_REENTRY_SL_BOUNCE_PCT=1.5
STRAT_TP_TRANCHES=
STRAT_TP_TREND_MIN_PCT=0.5
STRAT_TP_TRAIL_PCT=2
STRAT_TP_TRAIL_PROFIT_FLOOR_PCT=0
STRAT_TREND_OVERLAY=false
STRAT_TREND_SMA_N=30
STRAT_TREND_INTERVAL=240
STRAT_REGIME_MIN_SAMPLES=20
STRAT_TREND_TOPUP=2000
STRAT_TREND_TRAIL_PCT=5
STRAT_TREND_EXIT_BREAK=false
STRAT_TP_TRAIL_VOL_INTERVAL=240
STRAT_DCA_TREND_BRAKE=false
STRAT_DCA_BRAKE_MIN_PCT=1.5
STRAT_DCA_SPACING_GROWTH_PCT=0
STRAT_DCA_VOL_SCALE_K=0
STRAT_DCA_VOL_REF=2
STRAT_DCA_VOL_INTERVAL=240
