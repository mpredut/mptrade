# AUTHENTICATION: use an AGENT / API WALLET, NOT the main account private key!
#   More -> API -> "Generate" agent wallet -> Approve.
#   The agent wallet can trade, but CANNOT withdraw funds.
# ============================================================================
HL_SECRET_KEY=""        # agent wallet private key (0x...)
HL_ACCOUNT_ADDRESS=""   # main account address (the one holding USDC)

# Notifications
NTFY_TOPIC=
ALERT_TO_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
