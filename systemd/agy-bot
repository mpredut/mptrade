#!/usr/bin/env bash
# agy-bot: run agy for automated/headless callers (intelligence, supervisor) in a SEPARATE HOME so their
# conversations and summary rows never touch the store served by antigravity-cli-daemon (the Web UI).
# Self-provisioning: creates the bot home on first use and keeps credentials/projects in sync.
REAL_HOME="${REAL_HOME:-@TRADING_HOME@}"
RAW_BOT_HOME="${AGY_BOT_HOME:-$REAL_HOME/agy_bot_home}"
BOT_HOME="${RAW_BOT_HOME//\$HOME/$REAL_HOME}"
BOT_HOME="${BOT_HOME/#\~/$REAL_HOME}"
BOT_CLI="$BOT_HOME/.gemini/antigravity-cli"
REAL_CLI="$REAL_HOME/.gemini/antigravity-cli"
mkdir -p "$BOT_CLI" "$BOT_HOME/.gemini/config/projects"
[ -f "$BOT_CLI/settings.json" ] || cp -p "$REAL_CLI/settings.json" "$BOT_CLI/" 2>/dev/null
cp -au "$REAL_HOME/.gemini/config/." "$BOT_HOME/.gemini/config/" 2>/dev/null
# give the bot home the same login whenever the main one is newer (or missing)
if [ -f "$REAL_CLI/antigravity-oauth-token" ] && { [ ! -f "$BOT_CLI/antigravity-oauth-token" ] || [ "$REAL_CLI/antigravity-oauth-token" -nt "$BOT_CLI/antigravity-oauth-token" ]; }; then
  cp -p "$REAL_CLI/antigravity-oauth-token" "$BOT_CLI/antigravity-oauth-token" && chmod 600 "$BOT_CLI/antigravity-oauth-token"
fi
export HOME="$BOT_HOME"
exec "$REAL_HOME/.local/bin/agy" "$@"
