#!/usr/bin/env bash
# agy-bot: run agy for automated/headless callers (intelligence, supervisor) in a SEPARATE HOME with its
# own dedicated Google account/profile and isolated conversation store (never mutating or borrowing the
# human Web UI credentials served by antigravity-cli-daemon).
REAL_HOME="${REAL_HOME:-@TRADING_HOME@}"
RAW_BOT_HOME="${AGY_BOT_HOME:-$REAL_HOME/agy_bot_home}"
BOT_HOME="${RAW_BOT_HOME//\$HOME/$REAL_HOME}"
BOT_HOME="${BOT_HOME/#\~/$REAL_HOME}"
BOT_CLI="$BOT_HOME/.gemini/antigravity-cli"
REAL_CLI="$REAL_HOME/.gemini/antigravity-cli"
mkdir -p "$BOT_CLI" "$BOT_HOME/.gemini/config/projects" "$BOT_HOME/.config/antigravity"
[ -f "$BOT_CLI/settings.json" ] || cp -p "$REAL_CLI/settings.json" "$BOT_CLI/" 2>/dev/null || true
[ -f "$BOT_HOME/.gemini/config/config.json" ] || cp -p "$REAL_HOME/.gemini/config/config.json" "$BOT_HOME/.gemini/config/" 2>/dev/null || true
# Seed missing workspace project definitions (e.g. autonommptrade) without overwriting bot profile config or credentials.
cp -an "$REAL_HOME/.gemini/config/projects/." "$BOT_HOME/.gemini/config/projects/" 2>/dev/null || true
export HOME="$BOT_HOME"
exec "$REAL_HOME/.local/bin/agy" "$@"
