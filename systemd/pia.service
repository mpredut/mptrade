[Unit]
Description=PIA VPN + Dedicated IP + Port Forward Config
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
Environment="PIA_DIP_TOKEN=@TRADING_HOME@/piatoken.txt"
ExecStart=/bin/bash @TRADING_ROOT@/os_orchestrator/livecheck/pia_supervisor.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
