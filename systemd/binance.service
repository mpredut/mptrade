[Unit]
Description=Binance Python MultiScript Runner
After=network-online.target pia.service
Requires=pia.service

[Service]
Type=simple
User=@TRADING_USER@
WorkingDirectory=@TRADING_ROOT@
ExecStart=/bin/bash @TRADING_ROOT@/fleet_supervisor.sh
Restart=always
RestartSec=60
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
