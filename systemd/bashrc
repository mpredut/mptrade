export PATH=$PATH:/opt/piavpn/bin

alias python='python3'
cd @TRADING_ROOT@

# piactl without a timeout can hang interactive shells if pia-daemon wedges.
pia() { timeout 5 piactl "$@" 2>/dev/null; }

# Print VPN and network state on shell login
printf "🔐 VPN State      : %s\n" "$(pia get connectionstate)"
printf "🔌 Port Forward   : %s\n" "$(pia get portforward)"
printf "🌍 VPN exit IP    : %s\n" "$(pia get vpnip)"
printf "🏠 ISP link IP    : %s\n" "$(pia get pubip)"

# Display active fleet processes
ps -aux | grep -E 'python_orchestrator|orchestratorTrade' | grep -v grep || true

