# Scoped passwordless sudo for unattended fleet operation.
#
# Grants the trading user NOPASSWD on ONE root-owned wrapper only, so an agent/automation
# can run its FIXED subcommands (restart/stop/start/status/reinstall/rename) with no
# password and no console -- but nothing else. Because /usr/local/sbin/trading-admin is
# root-owned and not writable by the trading user, this is not a path to arbitrary root;
# the wrapper enforces exactly what may run (and refuses tampered repo scripts).
#
# Install once, as root (both files), while you are at the console:
#   sudo install -m 0755 -o root -g root systemd/trading-admin /usr/local/sbin/trading-admin
#   sudo install -m 0440 -o root -g root systemd/sudoers-trading /etc/sudoers.d/trading
#   sudo visudo -c        # validate the whole sudoers set before trusting it
#
# After that the trading user (and thus the agent) runs, unattended:
#   sudo /usr/local/sbin/trading-admin restart
#   sudo /usr/local/sbin/trading-admin rename mptrade
@TRADING_USER@ ALL=(root) NOPASSWD: /usr/local/sbin/trading-admin
