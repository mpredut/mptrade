# ============================================================================
# config.rgnt.env — RGNT (Regent). PREPARED 15 Jun, NOT deployed yet.
# CAUTION: a parabolic pump (+505% today, 5m bars of ±40%). This is a LOTTERY, not a strategy.
# Expunere reala plafonata INTENTIONAT la ~$1200 (sub plafonul tau de $3000):
# averaging adanc intr-un pump = mod sigur de a pierde tot.
# ============================================================================
ALERT_NEW_COIN=true

# --- Instrument ---
T212_TICKER=RGNT_US_EQ        # confirmat via --find-ticker
YAHOO_SYMBOL=RGNT
SYMBOL_LABEL=Regentis         # Regentis Biomaterials (an IL biotech), not "Regent".
EXPECTED_ISIN=IL0012190968    # guard: refuse if the ISIN does not match

# --- Strategie DCA + take-profit (sume in USD) ---
STRAT_ENABLED=true
STRAT_EXECUTE=true            # BANI REALI. --paper forteaza PAPER.
STRATEGY_MODE=avg_tp
STRAT_CURRENCY=USD            # the strategy budgets are in USD; the broker account is in RON (confirmed via API 2026-08-20)
STRAT_ENTRY_PCT=30.77        # The entry = 30.77% of MAX_BUDGET.
STRAT_ENTRY_DISCOUNT_PCT=5    # BUY 5% BELOW the price (a better entry on volatility; the TTL re-places it if the price runs away)
STRAT_DCA_PCT=30.77         # DCA = 30.77% of MAX_BUDGET.
STRAT_DCA_DROP_PCT=40         # add ONLY after a 40% crash (not on normal noise)
STRAT_MAX_DCA_BUYS=2          # EXPLICIT (not auto): it keeps the buffer INTENTIONALLY.
STRAT_FX_FEE_PCT=0.15         # RON base account -> the USD/RON conversion applies; 0 only after the account is really moved.
STRAT_TAKEPROFIT_PCT=35       # computed TP: +35% above the average price (one real swing, above fees and noise)
STRAT_MAX_BUDGET=420          # Capped to current holding cost (~407 USD) so bot does not overdraw cash.
STRAT_CHECK_MINUTES=0.3       # piata rapida (~18s)
STRAT_STOP_LOSS_PCT=50        # Catastrophic stop-loss (40% DCA drop is normal noise; 50% cuts disaster)
STRAT_SL_MHDSL_ENABLED=true   # Multi-Horizon Dynamic Stop Loss via centralized PositionExitManager
STRAT_TP_MDHTP_ENABLED=true   # Multi-Horizon Dynamic Take Profit (rides bull rallies, trails peak)
STRAT_ORDER_TTL_MIN=3         # Re-place the limit often if the price runs upwards.
STRAT_REENTRY_DROP_PCT=10     # after a TP it re-enters only at -10% below the sold price (stricter anti-churn)
STRAT_REENTRY_TOLERANCE_PCT=0.05  # Near-threshold tolerance (are_close) for re-entry and DCA.
STRAT_REENTRY_HYBRID_ENABLED=false
STRAT_REENTRY_PEAK_RELATIVE=false
STRAT_REENTRY_PULLBACK_PCT=1.5
STRAT_REENTRY_PULLBACK_ADAPTIVE=false
STRAT_REENTRY_PULLBACK_K=1.0
STRAT_REENTRY_PULLBACK_MIN=0.8
STRAT_REENTRY_PULLBACK_MAX=4.0
STRAT_REENTRY_TTL_HOURS=0.0
STRAT_SL_DISASTER_BUFFER_RATIO=0.30
STRAT_SL_DISASTER_BUFFER_MAX_PCT=15.0
STRAT_SL_TREND_DEFER_MAX_SEC=220.0
STRAT_SL_BOUNCE_MIN_RECOVERY_PCT=0.40
STRAT_SL_BOUNCE_PULLBACK_PCT=0.30
STRAT_SL_STRUCTURAL_BREAK_ENABLED=true
STRAT_TP_STAGNATION_MAX_SEC=1080.0
STRAT_LOSS_ALERT_STEP=1
STRAT_LADDER_MIN_FREE=6
STRAT_SL_REBUY_ENABLED=true
STRAT_SL_REBUY_BOUNCE_PCT=3.0
STRAT_DCA_TREND_GATE_PCT=0
STRAT_TRAIL_PCT=20           # TRAILING crash breaker: exit sustained 20% drop from peak
STRAT_TRAIL_MIN_PROFIT_PCT=20 # WARM-UP: trailing activates once +20% profit reached
STRAT_TP_LADDER=
POLL_SECONDS=60
