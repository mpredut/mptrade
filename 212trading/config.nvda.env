# ============================================================================
# 212trading — the NVIDIA PROFILE.  Select it with:  python3 ipo.py --profile nvda
# It IS committed (a versioned config). The secrets live in .env (gitignored).
# Structurally identical to config.spcx.env, only the instrument and the parameters differ.
# ============================================================================

ALERT_NEW_COIN=true

# --- Instrument ---
T212_TICKER=NVDA_US_EQ        # The exact instrument on T212 (--find-ticker to find out).
YAHOO_SYMBOL=NVDA             # The Yahoo symbol for the price.
SYMBOL_LABEL=NVIDIA
# Already listed -> it starts immediately (NVDA trades during US market hours).
EXPECTED_ISIN=US67066G1040    # guard: refuse if the ISIN does not match (NVIDIA)

# --- Strategie DCA + take-profit ---
STRAT_ENABLED=true            # true = the strategy; false = a single order (the ORDER_* below).
STRAT_EXECUTE=true            # true = BANI REALI; false = PAPER. --paper forteaza PAPER.
STRATEGY_MODE=avg_tp          # avg_tp (average cost plus take-profit) or dca_only
STRAT_CURRENCY=USD            # The strategy budgets/amounts are in USD; the broker account is in RON (confirmed via API 2026-08-20).
STRAT_ENTRY_PCT=15            # The entry = 15% of MAX_BUDGET (= ~12 USD at a budget of 80 USD).
STRAT_ENTRY_DISCOUNT_PCT=0.4  # Buy at market minus this % (a limit slightly below the market).
STRAT_DCA_PCT=9.44            # DCA = 9.44% of the budget (= ~7.55 USD at 80 USD). With a 15% entry plus auto => 9 steps.
STRAT_DCA_DROP_PCT=1.3        # buy again when the price drops this % below the last buy
STRAT_TAKEPROFIT_PCT=8.0      # Sell everything at avg_price*(1+%). Raised from 1.5% to 8.0% (validated in backtests: +103% vs +0.5%).
STRAT_CHECK_MINUTES=0.4       # How often, in minutes, the price is checked.
STRAT_MAX_BUDGET=80           # Right-sized to available free cash (408 RON ~= 87 USD) to prevent insufficient funds rejections.
STRAT_MAX_DCA_BUYS=auto       # AUTO from the budget: floor((1-15%)/9.44%)=9 steps (uses the whole 80 USD budget).
STRAT_FX_FEE_PCT=0.15         # RON base account -> the USD/RON conversion applies; 0 only after the account is really moved.
STRAT_ORDER_TTL_MIN=10        # re-places an unfilled limit BUY after this many minutes if the price rose
STRAT_STOP_LOSS_PCT=30        # PROFIT GUARD like SPCX (2026-06-24): never sell at a loss; 30 = the CATASTROPHE net only. Normal exit = TP only.
STRAT_SL_REBUY_ENABLED=true   # after a catastrophe (-30%), re-enter on an upward PULLBACK from the low (like Binance/Kraken trailing), not only below the sale
STRAT_SL_REBUY_BOUNCE_PCT=1.2 # The pullback %, from the low after the SL, for the re-buy.
STRAT_LOSS_ALERT_STEP=1       # Notify on every 1% the loss deepens (informational, it does not sell) instead of spam or silence.
STRAT_LADDER_MIN_FREE=6
STRAT_DCA_TREND_GATE_PCT=0
STRAT_TRAIL_PCT=0
STRAT_TRAIL_MIN_PROFIT_PCT=5
STRAT_TP_LADDER=
POLL_SECONDS=60

# --- Single-order mode (ONLY if STRAT_ENABLED=false) ---
ORDER_PRICE=150
ORDER_BUDGET_RON=3000
ORDER_VALIDITY=DAY
ORDER_EXECUTE=true
STRAT_REENTRY_DROP_PCT=0          # 0 = unblocked re-entry on market discount (validated in continuous backtest: +56.5% vs +0.5%).
STRAT_REENTRY_TOLERANCE_PCT=0.05  # "aproape de prag" = atins (are_close): reintrare + DCA (16 iul)
