# ============================================================================
# 212trading -- the ANT (Anthropic) PROFILE.  Select it with:  python3 ipo.py --profile ant
# It IS committed (a versioned config). The secrets live in .env (gitignored).
# ============================================================================

ALERT_NEW_COIN=true

# --- Instrument ---
T212_TICKER=ANT_US_EQ         # The exact instrument on T212 (verified via list_instruments)
YAHOO_SYMBOL=ANT              # The Yahoo symbol for the price.
SYMBOL_LABEL=Anthropic
EXPECTED_ISIN=US03703U1079    # guard: refuse if the ISIN does not match (Anthropic)

# --- DCA + take-profit strategy ---
STRAT_ENABLED=true            # true = the strategy; false = a single order (the ORDER_* below).
T212_BOT_OBSERVE_ONLY=true    # true = observational mode (reconciles portfolio/fills without placing orders; AI managed)
STRAT_EXECUTE=true            # true = REAL MONEY; false = PAPER. --paper forces PAPER.
STRATEGY_MODE=avg_tp          # avg_tp (average cost plus take-profit) or dca_only
STRAT_CURRENCY=USD            # The strategy budgets/amounts are in USD; the broker account is in RON.
STRAT_ENTRY_PCT=15            # Minimum entry slice when auto-sizing.
STRAT_ENTRY_DISCOUNT_PCT=0.5  # Passive limit slightly below live spot.
STRAT_DCA_PCT=10              # DCA slice percentage.
STRAT_DCA_DROP_PCT=4.0        # Wide post-IPO spacing.
STRAT_DCA_TREND_GATE_PCT=0.10 # No DCA during confirmed steep downtrend.
STRAT_TAKEPROFIT_PCT=9        # Fallback TP level (+9%).
STRAT_TP_LADDER=range:9:40:5  # Dynamic scale-out ladder between +9% and +40%.
STRAT_TP_LADDER_CURVE=bell    # Gaussian bell distribution.
STRAT_CHECK_MINUTES=0.3       # Check every ~18s during RTH.
STRAT_MAX_BUDGET=380          # Right-sized to available T212 USD cash.
STRAT_FX_FEE_PCT=0.15         # RON base account FX conversion fee.
STRAT_MAX_DCA_BUYS=auto       # Derived from budget and slice sizes.
STRAT_ORDER_TTL_MIN=3         # Re-place stale unfilled limit orders.
STRAT_STOP_LOSS_PCT=30        # Catastrophe stop-loss net.
STRAT_SL_MHDSL_ENABLED=true   # Multi-Horizon Dynamic Stop Loss.
STRAT_TP_MDHTP_ENABLED=true   # Multi-Horizon Dynamic Take Profit.
STRAT_TRAIL_PCT=8             # Trailing crash breaker after +9% warm-up.
STRAT_TRAIL_MIN_PROFIT_PCT=9  # Profit guard warm-up threshold.
STRAT_SL_REBUY_ENABLED=true   # Re-enter on upward bounce after SL.
STRAT_SL_REBUY_BOUNCE_PCT=1.2 # Bounce threshold from SL low.

# --- Single-order mode (ONLY if STRAT_ENABLED=false) ---
ORDER_PRICE=95
ORDER_BUDGET_RON=1500
ORDER_VALIDITY=DAY
ORDER_EXECUTE=true
STRAT_REENTRY_DROP_PCT=2.0
STRAT_REENTRY_HYBRID_ENABLED=true
STRAT_REENTRY_PEAK_RELATIVE=false
STRAT_REENTRY_PULLBACK_PCT=1.5
STRAT_REENTRY_PULLBACK_ADAPTIVE=true
STRAT_REENTRY_PULLBACK_K=1.0
STRAT_REENTRY_PULLBACK_MIN=0.8
STRAT_REENTRY_PULLBACK_MAX=3.5
STRAT_REENTRY_TTL_HOURS=48.0
STRAT_REENTRY_TOLERANCE_PCT=0.05
STRAT_SL_DISASTER_BUFFER_RATIO=0.30
STRAT_SL_DISASTER_BUFFER_MAX_PCT=15.0
STRAT_SL_TREND_DEFER_MAX_SEC=220.0
STRAT_SL_BOUNCE_MIN_RECOVERY_PCT=0.40
STRAT_SL_BOUNCE_PULLBACK_PCT=0.30
STRAT_SL_STRUCTURAL_BREAK_ENABLED=true
STRAT_TP_STAGNATION_MAX_SEC=1080.0
STRAT_LOSS_ALERT_STEP=1
STRAT_LADDER_MIN_FREE=6
POLL_SECONDS=60
