# ============================================================================
# Kraken - SECRETS. Copy to .env and fill in:  cp .env.example .env
# Config (pair, strategy parameters) lives in config.env (already committed).
# API key permissions: Query Funds, Query Open/Closed Orders, Create & Modify
# Orders. DO NOT grant withdrawal permissions to bot keys.
# ============================================================================
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional dedicated IP-restricted key used ONLY by verify_tools/rebalance_kraken_to_hl.py
# (Query Funds + Withdraw Funds restricted to whitelisted Arbitrum One Native USDC address).
KRAKEN_API_KEY_TRANSFER=
KRAKEN_API_SECRET_TRANSFER=
# Optional withdrawal address key label (auto-resolved when uniquely matching HL_ACCOUNT_ADDRESS)
KRAKEN_HL_ARB_WITHDRAW_KEY=

# Notifications
NTFY_TOPIC=
ALERT_TO_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
