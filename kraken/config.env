# ============================================================================
# Kraken - a VERSIONED config (it IS committed). The secrets live in .env (gitignored).
# The bot loads .env first (secrets and local overrides win), then this file.
# ============================================================================
KRAKEN_PAIR=HYPEUSD           # HYPEEUR or HYPEUSD (--find-pair hype to find out)
KRAKEN_BOT_POLL_SEC=60
# KRAKEN_CACHE_PAIRS and KRAKEN_TRADABLE_PAIRS are sourced from instruments.conf SSOT (HYPEUSD, TAOUSD, ADAUSD); uncomment only to override.
# KRAKEN_CACHE_PAIRS=HYPEUSD,TAOUSD,ADAUSD
# KRAKEN_TRADABLE_PAIRS=HYPEUSD,TAOUSD,ADAUSD
KRAKEN_CACHE_POLL_S=30
KRAKEN_CACHE_BACKOFF_INIT_S=10
KRAKEN_CACHE_BACKOFF_MAX_S=120
KRAKEN_CACHE_MODE=ws
KRAKEN_CACHE_LOOKBACK_H=336
SYMBOL_LABEL=Kraken          # cosmetic label for banner/notifications (was wrongly 'Hyperliquid')

# ============================================================================
# DCA + take-profit strategy (amounts are in the pair's quote currency)
# ============================================================================
KRAKEN_BOT_OBSERVE_ONLY=true  # true = observational mode (reconciles fills/state without placing orders; AI managed)
STRAT_EXECUTE=true            # false = PAPER; true = REAL MONEY. --paper forces PAPER.
STRATEGY_MODE=avg_tp          # avg_tp (average cost plus take-profit) or dca_only
STRAT_CURRENCY=USD            # quote currency of the pair (HYPEUSD -> USD)
STRAT_ENTRY=650               # initial buy (15 Jul: USDC converted to USD -> ~3900 allocation)
STRAT_ENTRY_DISCOUNT_PCT=0.8  # Buy at market minus this %.
STRAT_DCA=325                 # A buy on a fall (15 Jul: scaled together with ENTRY).
STRAT_DCA_DROP_PCT=1.35       # 29_COMBO_ultimate_balanced winner: 1.35% base drop with 0.25pp spacing growth
STRAT_DCA_SPACING_GROWTH_PCT=0.25 # Widens spacing progressively (+0.25pp per tier) to reduce max drawdown.
STRAT_TAKEPROFIT_PCT=6.0      # Candidate 03_tp6 winner: +70.14% net compounding replay, Calmar 3.37, 58.6% WR
STRAT_CHECK_MINUTES=2         # How often, in minutes, the price is checked.
STRAT_MAX_BUDGET=3900         # Spending CAP per cycle (safety). Effectively $3900 (650+10x325);
                              # total cash ~$4728 -> ~$800 left as BUFFER for SPCX DCA (15 Jul decision).
STRAT_MAX_DCA_BUYS=10         # maximum number of DCA buys on a dip
STRAT_ORDER_TTL_MIN=10        # re-places an unfilled buy after this many minutes if the price rose

# ============================================================================
# xStocks / ANTx (Anthropic) IPO allocation (kraken_xstock_watch.py)
# ============================================================================
XSTOCK_REGEX=^(?:ANTX|ANTSPV)(?:[./]|USD|EUR|$)  # matches ANTx.T, ANTx, ANTxUSD, ANTx/USD, ANTSPVUSD (excludes MANTRA, ANTOx)
XSTOCK_SYMBOL_LABEL=ANTx      # notification label for the spawned xStock strategy bot
XSTOCK_ARCHIVE_PAIRS=         # extra xStock pairs not yet in instruments.conf; SPCXxUSD is now owned by cacheManager ([KRAKEN_SPCX])
XSTOCK_ACTIVE_PAIRS=SPCXxUSD:141.75  # already-listed xStock pairs supervised live by kraken_xstock_watch (<PAIR>:<ADOPT_COST>)
XSTOCK_QUOTE=USD              # If several pairs appear (USD+EUR), prefer this one.
XSTOCK_TRIAL_ASSET=ADA        # existing zero-money trial asset used by --trial
XSTOCK_CHECK_MINUTES=0.5      # Poll every 30s for allocation arrival, API listing, and levels.
XSTOCK_ALLOC_PRICE=0          # 0 = auto-derived from Kraken Ledger (krakenlaunchallocation / tokenizedipoallocation).
XSTOCK_TP_ALERT_PCT=10        # Alert 1 at +10% above real allocation cost (Tranche 1 fill level).
XSTOCK_TP2_ALERT_PCT=16       # Alert 2 at +16% above real allocation cost (Trailing active).
XSTOCK_SL_ALERT_PCT=12        # Informational downside alert at -12% (no automatic stop-loss sale).
XSTOCK_YAHOO=ANT              # Nasdaq ticker fallback while the Kraken API pair is not yet online.

# --- AUTOMATIC 2-PHASE IPO -> CYCLIC BOT (started by kraken_xstock_watch.py) ---
# Calibrated for a realistic / non-explosive IPO (+10%..+28% pop, 4.3x higher expected PnL vs AI-hype thresholds):
# Phase 1 (IPO Allocation Cycle 1):
#   - 50% resting Maker limit sell at +10% (locks half immediately even on a mild +10%..+12% Day-1 pop)
#   - 50% held off-book and trailed with a 3.5% pullback once price reaches +16% (uncapped upside if rally extends)
#   - Zero DCA, zero stop-loss on opening wicks
# Phase 1 -> Phase 2 Maturation Gate (after Cycle 1 closes in USD cash):
#   - Waits for >=20% post-IPO compression off peak + >=20 4h bars + non-bear bounce
# Phase 2 (Normal Matured Cyclic DCA+TP, calibrated on SPCXxUSD 1h history, Calmar >6):
#   - Entry $500, DCA $450 x 5 at -3.0% ($2750 cap), TP +9.0% + 3.0% trail + MDHTP
XSTOCK_AUTOSTART=true
XSTOCK_BOT_PAPER=false
XSTOCK_BOT_OBSERVE_ONLY=false
XSTOCK_BOT_IPO_TP_TRANCHES=10:50,16:50
XSTOCK_BOT_IPO_TRAIL_PCT=3.5
XSTOCK_BOT_IPO_REENTRY_DROP_PCT=20
XSTOCK_BOT_ENTRY=500
XSTOCK_BOT_DCA=450
XSTOCK_BOT_MAX_DCA_BUYS=5
XSTOCK_BOT_DCA_DROP_PCT=3.0
XSTOCK_BOT_MAX_BUDGET=2750
XSTOCK_BOT_TP_PCT=9.0
XSTOCK_BOT_TP_TRANCHES=
XSTOCK_BOT_TP_TREND_HOLD=true
XSTOCK_BOT_TP_TRAIL_PCT=3.0
XSTOCK_BOT_TP_TRAIL_ADAPTIVE=false
XSTOCK_BOT_TP_MDHTP_ENABLED=true
XSTOCK_BOT_TP_DYNAMIC_FLAT=false
XSTOCK_BOT_SL_PCT=0
XSTOCK_BOT_TREND_OVERLAY=false
XSTOCK_BOT_CHECK_MINUTES=0.25

# --- Adopting an existing position in kraken_bot (used by the auto-start; manually:) ---
#   STRAT_ADOPT_COST=<alloc_price> python3 kraken_bot.py --pair <SPCX_PAIR>
STRAT_ADOPT_COST=0            # >0 = adopt the account position at this average cost (the allocation price)
STRAT_ADOPT_QTY=0             # 0 = read the quantity from the balance automatically
STRAT_IPO_TP_TRANCHES=
STRAT_IPO_TRAIL_PCT=0
STRAT_IPO_REENTRY_DROP_PCT=0
# Hybrid re-entry: buys dynamic dip in confirmed trend (reentry_pullback_adaptive),
# while preserving 2.5% defensive discount in chop/bear (reentry_drop_pct, 16_reentry_pullback_25 winner)
# plus a minimum bounce off the trough to prevent catching falling knives.
STRAT_REENTRY_DROP_PCT=2.5
# BACKTEST: 0.0, 0.5, 0.8, 1.0, 1.5
STRAT_REENTRY_BEAR_BOUNCE_PCT=0.5
STRAT_REENTRY_HYBRID_ENABLED=true
STRAT_REENTRY_PULLBACK_ADAPTIVE=true
STRAT_REENTRY_PULLBACK_K=1.0
STRAT_REENTRY_PULLBACK_MIN=0.8
STRAT_REENTRY_PULLBACK_MAX=3.5
STRAT_REENTRY_TTL_HOURS=48.0
STRAT_REENTRY_TOLERANCE_PCT=0.05  # "close to the threshold" = reached (are_close from botcore, deterministic).
                              # It applies to the RE-ENTRY and to the DCA. (16 Jul: HYPE bounced at
                              # 65.93 vs threshold 65.91 - 2 cents - and missed the entry)
STRAT_REENTRY_ADAPTIVE=false  # 30 Jul: true->FALSE. A ROBUST check (14 windows, 4h ~120 days
                              # that also cover the bull regime + 1h ~30d): FIXED >= adaptive EVERYWHERE
                              # (a tie in 9/14, including the whole bull where the adaptive one does not help at all;
                              # FIXED wins 4/5 of those that differ, in DECLINE - e.g. 1h FULL -2.46%
                              # vs -4.19%, 1h H2 -6.07% vs -7.76%; the only marginal adaptive win is
                              # 0.38%). The OLD verdict (23 Jul: adaptive +3.26% vs +2.20% over ~30 days)
                              # was regime-dependent (a bull window, small sample) and does NOT hold on
                               # fuller data. FIXED is better/safer in a decline, identical in a bull.
                               # 23 Jul: adaptive threshold = SHADOW_K_REENTRY * vol_1h. Fails safe to fixed anyway.
                               # The DCA STAYS FIXED (the adaptive one did not beat it, confirmed).
SHADOW_K_REENTRY=2.0
# --- TP IN TRANCHES (optional): "3:50,6:50" = sell 50% at +3%, the rest at +6% ---
STRAT_TP_TRANCHES=            # empty = the classic TP (a single order over the whole position)

# TP TRAILING (v2, 19 Aug): above the TP level, instead of selling at a fixed point, RIDE the trend and exit
# on a pullback of STRAT_TP_TRAIL_PCT% from the peak. Below the TP we do not sell (safety = the stop-loss).
# Faithful multi-period HYPEUSD backtest: trail=3% was robust (positive at 60m/240m/1440m
# and beat classic TP at 240m by 6.5% and at 1440m by 6.7%); trail=2% overfit the 240m data.
STRAT_TP_TREND_HOLD=true      # Enable trailing after TP (false keeps classic fixed TP).
STRAT_TP_TRAIL_PCT=3.0        # The pullback from the peak at which we exit (3% = the robust choice).
STRAT_TP_TRAIL_PROFIT_FLOOR_PCT=1.0  # +1% minimum profit floor for trailing exits.
STRAT_TP_MDHTP_ENABLED=true   # Multi-Horizon Dynamic Take Profit (rides bull rallies, trails peak, stagnation timeout)

# Explicit shared-engine policy. Zero/false values intentionally disable features.
STRAT_STOP_LOSS_PCT=25       # Catastrophic stop-loss (DCA buys normal dips; 25% cuts runaway market crash)
STRAT_REENTRY_PEAK_RELATIVE=false
STRAT_REENTRY_PULLBACK_PCT=2.5
STRAT_TOTAL_BUDGET=0
STRAT_ALLOC_PCT=0
STRAT_ENTRY_PCT=0
STRAT_DCA_PCT=0
STRAT_REENTRY_SL_BOUNCE_PCT=1.5
STRAT_TP_TREND_MIN_PCT=0.5
STRAT_TREND_OVERLAY=true      # Enabled: participates in bull market rallies via top-up & trailing stop.
STRAT_TREND_SMA_N=30
STRAT_TREND_INTERVAL=240
STRAT_REGIME_MIN_SAMPLES=20
STRAT_TREND_TOPUP=650         # Sized to base entry amount (650 USD).
STRAT_TREND_TRAIL_PCT=8.0     # 8% trailing stop in trend mode.
STRAT_TREND_EXIT_BREAK=false
STRAT_TP_TRAIL_ADAPTIVE=true   # Volatility-adaptive trailing stop (k=1.8, clamp 1.5-7.5%, from 29_COMBO_ultimate_balanced)
STRAT_TP_TRAIL_K=1.8
STRAT_TP_TRAIL_MIN=1.5
STRAT_TP_TRAIL_MAX=7.5
STRAT_TP_TRAIL_VOL_INTERVAL=240
STRAT_DCA_TREND_BRAKE=true    # Brake on: prevents adding DCA buys during steep market drops.
STRAT_DCA_BRAKE_MIN_PCT=1.5
STRAT_DCA_VOL_SCALE_K=0
STRAT_DCA_VOL_REF=2
STRAT_DCA_VOL_INTERVAL=240

# ============================================================================
# Multi-Horizon Dynamic Profit Architecture (MHDPA)
# ============================================================================
# Parabolic Surge Guard: locks in multi-day blow-off tops (+18% gain with 3.5% pullback)
# Calibrated fixed winner from deep overnight sweep: 18% trigger with 3.5% pullback
STRAT_SURGE_GUARD=true
# BACKTEST: 18.0, 20.0, 21.0, 22.0, 25.0
STRAT_SURGE_GAIN_PCT=18.0
# BACKTEST: 48.0, 72.0, 96.0
STRAT_SURGE_WINDOW_HOURS=72.0
STRAT_SURGE_MOVE_PCT=18.0
# BACKTEST: 2.8, 3.0, 3.2, 3.5, 3.8
STRAT_SURGE_EXIT_PULLBACK_PCT=3.5
STRAT_SURGE_DYNAMIC=false
STRAT_SURGE_MIN_GAIN_PCT=18.0
STRAT_SURGE_MAX_GAIN_PCT=26.0
STRAT_SURGE_VOL_MULTIPLIER=8.0

# Fast Micro-Gradient Guard: 2x TP (+10%) with 5-minute 1.0% drop
STRAT_FAST_PROFIT_GUARD=true
STRAT_FAST_PROFIT_MULT=2.0
STRAT_FAST_PROFIT_WINDOW_MIN=5.0
STRAT_FAST_PROFIT_DROP_PCT=1.0

# Dynamic Flat TP: 3% in chop to 7% at breakout cusp
STRAT_TP_DYNAMIC_FLAT=true
STRAT_TP_MIN_PCT=3.0
STRAT_TP_MAX_PCT=7.0

# Dynamic Trend Trailing (Profit Ratchet): ratchets 8% down to 4% as gain expands
STRAT_TREND_TRAIL_DYNAMIC=false
STRAT_TREND_TRAIL_BASE_PCT=8.0
STRAT_TREND_TRAIL_MIN_PCT=4.0
STRAT_TREND_TRAIL_RATCHET_K=0.3
STRAT_TREND_TRAIL_GAIN_THRESH=8.0

# Slow-Grind Guard: 7-day held position with >= 15% gain exits on flash or structural drop
STRAT_SLOW_GRIND_GUARD=false
STRAT_SLOW_GRIND_DAYS=7.0
STRAT_SLOW_GRIND_MIN_GAIN_PCT=15.0
STRAT_SLOW_GRIND_FLASH_WINDOW_MIN=15.0
STRAT_SLOW_GRIND_FLASH_DROP_PCT=1.5
STRAT_SLOW_GRIND_HOURLY_DROP_PCT=2.5

# Multi-Horizon Dynamic Stop-Loss (MHDSL) & MDHTP Stagnation
STRAT_SL_MHDSL_ENABLED=true
STRAT_SL_DISASTER_BUFFER_RATIO=0.30
STRAT_SL_DISASTER_VOL_MULTIPLIER=0.85
STRAT_SL_DISASTER_BUFFER_MIN_PCT=0.80
STRAT_SL_DISASTER_BUFFER_MAX_PCT=15.0
STRAT_SL_TREND_DEFER_MAX_SEC=220.0
STRAT_SL_BOUNCE_MIN_RECOVERY_PCT=0.40
STRAT_SL_BOUNCE_PULLBACK_PCT=0.30
STRAT_SL_BOUNCE_RATCHET_ENABLED=true
STRAT_SL_BOUNCE_RATCHET_K=0.50
STRAT_SL_BOUNCE_MIN_PULLBACK_PCT=0.15
STRAT_SL_STRUCTURAL_BREAK_ENABLED=true
STRAT_TP_STAGNATION_MAX_SEC=1080.0
