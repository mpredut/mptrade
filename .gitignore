# ============================================================================
# .gitignore
# Secrete (.env, *.pem) NU se comit NICIODATA. Config NEsensibil = config.env /
# *.conf (versionate). Datele/cache-ul (json/jsonl/meta/lock/bak) se ignora global.
# ============================================================================

# --- Secrete (niciodata in git) ---
.env
*.pem

# --- Config local / editor ---
.claude/settings.local.json
*.swp
*.swo
*.tmp
*~

# --- Auto-deploy / fleet: per-machine local config + pause flag (NOT tracked) ---
autodeploy.local.conf
FLEET_PAUSED

# --- Python / build / venv ---
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
.myenv/
myenv/

# --- Date runtime / cache (cachedb/ + fisiere razlete) ---
cachedb/
*.json
!offline/research/hype_dataset/financial_baseline_v1.json
!offline/research/t212_dataset/manifest.json
*.jsonl
*.meta
*.lock
*.bak
index.html

# --- Loguri ---
*.log
*.log.[0-9]*
.logrotate.state
# logs/ intreg = runtime (bot logs, shadow jsonl, arhive) — nu se versioneaza; pastram doar .gitkeep
logs/*
!logs/.gitkeep

# --- Observabilitate tradeall (artefacte generate, nu cod) ---
tradeall_live/
# 21 iul: logger/ intreg (nu doar backtest/) — jurnale generate, nu cod; gasit
# netrackat inainte, risc real ca un "git add -A" neatent sa comita >1GB de
# loguri in istoricul git permanent (vezi si logger_retention.sh/rotate_logs.sh
# pt curatarea lor pe disc).
logger/

# Propunerile de backtest (dev) — traiesc DOAR pe branch-ul backtest-proposals
# (scrise cu `git add -f`), nu pe main. Vezi `offline/runners/`.
backtest_proposals.json

# Frozen datasets and walk-forward reports generated locally or on dev.
offline/results/

# Artefacte generate de drawPriceLst (priceAnalysis.py savefig) — nu cod.
plot_*.png

# --- Artefacte locale din root (nu cod / nu date de benchmark) ---
/nohup.out
/plots/
/sell_recommendation.csv
/commit
/*.patch
*:Zone.Identifier
.env.bak*
*.bak_*
