# Secrets (never in git)
.env
.env*
env/
*.pem

# Python / virtualenv / build
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
.myenv/
myenv/

# Editor & OS artifacts
*.swp
*.swo
*.tmp
*~
*:Zone.Identifier
.claude/settings.local.json

# Production / local fleet state
autodeploy.local.conf
FLEET_PAUSED

# Runtime databases & caches
cachedb/
*.lock
*.meta
*.bak*

# State files (*.json in root and subdirectories are runtime states, except tracked schema/config)
*/**/*.json
.*_state.json
priceanalysis.json
kraken_trades_full.json
last_watch_config.json
index.html
tradeall_live/
!notify_engine/rules.json
!offline/research/hype_dataset/financial_baseline_v1.json
!offline/research/t212_dataset/manifest.json

# Runtime logs & price streams
*.log
*.log.*
.logrotate.state
logs/*
!logs/.gitkeep
logger/

# Offline datasets & proposals
offline/results/

