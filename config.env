# ============================================================================
# binance (root) — a VERSIONED config (it IS committed). The secrets live in .env (gitignored).
# Loaded by run_price_monitor.py and price_monitor_watchdog.py after .env.
# ============================================================================
TRADE_ENABLED=true            # Master trade execution switch (true enables real orders, false disables them)
ALERT_NEW_COIN=True           # alert on newly discovered coins
STOCK_TICKERS=SPCX            # Yahoo fallback symbols; comma-separated

# ============================================================================
# LEGACY: the SPCX order/strategy — MOVED into 212trading/ (config.spcx.env, config.nvda.env).
# Kept here only for compatibility; the price monitor does NOT use these values.
# ============================================================================
T212_ENV=live                 # live (real money) or demo
ORDER_PRICE=150               # A cap: the maximum LIMIT price per share, USD.
ORDER_BUDGET_RON=3000         # A RON budget; the quantity is computed automatically at the live rate.
ORDER_VALIDITY=DAY            # DAY or GTC (= GOOD_TILL_CANCEL)
ORDER_EXECUTE=true            # true = real orders; false = a dry run.
ORDER_EXPECTED_ISIN=US84615Q1031   # guard: the order is placed ONLY if the ISIN matches (SpaceX)
STRAT_ENABLED=true            # true = on launch it starts the strategy instead of a single order.
STRAT_EXECUTE=false           # false = PAPER (simulation only); true = REAL trades.
STRATEGY_MODE=avg_tp          # avg_tp (average cost plus take-profit) or dca_only
STRAT_ENTRY_EUR=400           # initial buy size (EUR)
STRAT_ENTRY_DISCOUNT_PCT=0.002  # Buy at market minus this %.
STRAT_DCA_EUR=100             # dip DCA buy size (EUR)
STRAT_DCA_DROP_PCT=0.01       # buy again when the price drops this % below the last buy
STRAT_TAKEPROFIT_PCT=0.02     # sell everything when the price >= average_price * (1 + this %)
STRAT_CHECK_MINUTES=0.3       # How often, in minutes, the price is checked.
STRAT_MAX_BUDGET_EUR=500      # total budget cap spent per cycle (safety)
STRAT_MAX_DCA_BUYS=10         # maximum number of dip buys (safety)
STRAT_ORDER_TTL_MIN=10        # re-places an unfilled limit BUY after this many minutes if the price rose

# ============================================================================
# Cache watchdog — auto-restart (28 Jul). When a FAST price cache is stale
# (the fleet really does have a problem, e.g. the HYPE incident with the DNS hang),
# watchdogfor_cache.py restarts cacheManager itself (the flota_start supervisor
# respawns it) alongside the alert. The guardrails against loops are below.
# Kill switch: set false to disable it immediately (no code redeploy).
# ============================================================================
WATCHDOG_AUTO_RESTART=true
WATCHDOG_STALE_MINUTES=20
WATCHDOG_COOLDOWN_MINUTES=60
WATCHDOG_FAST_PRICE_MINUTES=5
WATCHDOG_AUTO_RESTART_COOLDOWN_MIN=15    # The minimum between 2 automatic restarts.
WATCHDOG_AUTO_RESTART_MAX=3              # The maximum automatic restarts per window...
WATCHDOG_AUTO_RESTART_WINDOW_H=6         # ...of this many hours; beyond that -> ask for manual intervention.

# CONFIG WATCH (watchdogfor_cacheandconfig): it restarts the owning process when
# a config file has changed (a content hash). Kill switch: set it to false.
WATCHDOG_CONFIG_RESTART=true
WATCHDOG_CONFIG_COOLDOWN_MIN=5           # The minimum between 2 restarts on a config change.
WATCHDOG_CONFIG_MAX=5                    # The maximum config restarts per window...
WATCHDOG_CONFIG_WINDOW_H=6               # ...within this many hours; beyond that -> alert only

# Log anomaly watchdog policy. These are mandatory operational thresholds; missing
# configuration must stop the watchdog instead of silently selecting new behavior.
ANOMALY_WINDOW_FILES_MIN=30
ANOMALY_COOLDOWN_MINUTES=30
ANOMALY_MAX_READ_BYTES=4194304
ANOMALY_THRESH_RATE_LIMIT=30
ANOMALY_THRESH_AUTH=3
ANOMALY_THRESH_BLIND=25
ANOMALY_THRESH_EXECUTION_BLOCKED=25
ANOMALY_THRESH_TRACEBACK=1

# Process resource watchdog. It samples /proc every two minutes (see flota_start.sh)
# and alerts only after a sustained breach, not for short startup spikes.
RESOURCE_CPU_THRESHOLD_PCT=50
RESOURCE_MEMORY_THRESHOLD_MB=750
RESOURCE_CONSECUTIVE_CHECKS=3
RESOURCE_RECOVERY_CHECKS=2
RESOURCE_ALERT_COOLDOWN_MINUTES=60
RESOURCE_CHECK_INTERVAL_MINUTES=2
RESOURCE_AUTO_RESTART=true
RESOURCE_RESTART_COOLDOWN_MINUTES=15
RESOURCE_RESTART_MAX=3
RESOURCE_RESTART_WINDOW_HOURS=6

# Read-only monitoring policy.
RISK_DD_ALERT_PCT=8
RISK_DD_REALERT_HOURS=6
RISK_DD_WORSEN_PCT=2
MONITOR_PORT=32238
# ============================================================================
# assetguardian_config.env — the tunable parameters of assetguardian.py (a VERSIONED
# config, it IS committed — no secrets). Loaded automatically by assetguardian.py
# at startup (botcore.load_dotenv), before any os.environ.get(...) in the
# file.
#
# 23 Jul: the values below were extracted from hardcoded constants.
# 26 Aug: signals and campaigns are evaluated and executed separately per asset.
# BUY bypasses only the historical SELL reference. SELL retains profit checks;
# explicit tranches bypass only the dynamic weight cap.
#
# ALL the AG_* keys below are mandatory. The code has no defaults;
# a missing, empty or invalid value stops the process at startup.
#
# CAUTION, this is real money: changing these values changes DIRECTLY when
# assetguardian sells or buys each tracked asset separately. The real protection of
# crash handling stays in trailing_stop.py; the SELL tiers are profit-taking, not stop-loss.
# ============================================================================

# The interval between two evaluations of the main loop (run_forever).
AG_CHECK_INTERVAL_SEC=54

# Symbols are selected by role.assetguardian in instruments.conf.

# SELL tranches per asset: growth_pct:fraction_of_initial_campaign_quantity.
# At the first tranche, the window's low and the free balance are frozen.
# The profit reference remains active; only quantity/weight policy is bypassed.
AG_SELL_TIERS=15:0.30,25:0.30,35:0.40

# Hysteresis against the frozen low. After a SELL campaign starts,
# the price returning to at most +5% above that low clears the campaign; a
# future campaign will again use the window's current moving low.
AG_SELL_REARM_GROWTH_PCT=5

# Shared operational TTL for a BUY/SELL limit order created by AssetGuardian.
# After 900s the Guardian re-queries its own order by orderId/clientOrderId
# and requests a single cancellation. It never cancels other modules' orders. An ambiguous cancel
# stays pending/fail-closed and allows no automatic resubmit.
AG_ORDER_MAX_AGE_SEC=900

# How many consecutive "no order with this client_order_id" replies are
# needed before an ambiguous intent is released without a fill.
AG_ORDER_MISSING_CONFIRMATIONS=1

# AssetGuardian does not sleep inside Instrument.place. If the short trend favours a
# better price, the intent is deferred non-blockingly and re-evaluated each cycle,
# for at most 180s. On expiry it is placed only if the signal is still valid.
AG_TREND_DEFER_MAX_SEC=180

# The window (minutes) used as the reference for computing the rise/fall of
# each symbol from the Price24 cache. 1440 = 24h.
AG_REFERENCE_MINUTES_BACK=1440

# The maximum fraction of free USDC cash that forms a campaign's budget
# per asset (0.995 = 99.5%; the remainder is a fee/precision buffer).
AG_BUY_USE_CASH_RATIO=0.995

# BUY tranches per asset: drawdown_pct:fraction_of_that_asset_budget.
# Only a terminal fill completes the tranche; a partial one only reduces the real cost.
# The cash is shared; at most one accepted order is issued per cycle.
AG_BUY_TIERS=7:0.35,10:0.35,14:0.30

# Re-arm the asset's campaign separately after recovering below this drawdown.
AG_RECOVERY_RESET_PCT=3.0

# Dynamic interval: normally 54s, 30s near an asset's next threshold,
# and 15s while a valid tranche is refused by safe-order.
AG_NEAR_TRIGGER_SEC=30
AG_ACTIVE_TRIGGER_SEC=15
AG_NEAR_TRIGGER_DISTANCE_PCT=2.0
# ============================================================================
# bapi_placeorder_config.env — the tunable parameters of binance_api/bapi_placeorder.py
# (a VERSIONED config, it IS committed — no secrets). Loaded automatically by
# bapi_placeorder.py on import (botcore.load_dotenv), before any
# os.environ.get(...) in the file.
#
# On July 30, the values below were extracted from hardcoded constants with
# identical values, so leaving them unchanged preserves behavior. The goal was
# to move every bot parameter, threshold, and multiplier into configuration,
# following the same approach used for tradeall_config.env and
# monitortrades_config.env on July 23.
#
# CAUTION, this is real money: this file controls the final CHOKEPOINT of
# order placement (__place_order), used by the WHOLE trading chain
# (tradeall, monitortrades, rtrade, market_api). Changing these values
# DIRECTLY change when, how much and how real BUY/SELL orders are sent.
# ============================================================================

PLACE_ORDER_FEE_PCT=0.001          # The estimated fee, used when adjusting qty (BUY/SELL) next to the fee.
PLACE_ORDER_HOURS=5                # The window (hours) for cancel_orders_old_or_outlier when releasing qty.

# How far place_safe_order/if_place_safe_order looks back for recent trades used
# by the anti-spam ("recent_transaction"/"daily_limit") and profit guards. On
# July 30 this changed from 48 hours to 14 days. The main callers already pass a
# similar window explicitly; this default affects callers that omit it, including
# normal rtrade, monitororder, server, and archive/monitortrades_legacy.
PLACE_ORDER_SAFEBACK_SEC=1209660   # 14 days + 60 seconds

PLACE_ORDER_MAX_DAILY_TRADES=25    # A cap on trades per day (if_place_safe_order) before a "daily_limit" refusal.
PLACE_ORDER_MIN_NOTIONAL=100       # business minimum; exchange minimum remains symbol metadata

# The trend is checked instantly in Instrument.place. There are no sleep/polling
# parameters here: a refusal goes into the outbox and is re-evaluated by the worker later.
# Mandatory, versioned CacheManager configuration. Contains no secrets.
# These bounds constrain on-demand trend windows built from the raw Price24 buffer.
CM_DYNAMIC_WINDOW_MIN_SEC=14
CM_DYNAMIC_WINDOW_MAX_SEC=21600
LONGTREND_NONBINANCE=false

# Mandatory disk-persistence policy. These values bound append-only history and
# make retention behavior explicit instead of relying on constants hidden in code.
CM_RETENTION_DAYS=730
CM_RETENTION_CHECK_INTERVAL_SEC=604800
CM_APPEND_MAX_FILE_BYTES=1000000000
CM_ROTATE_KEEP_FRACTION=0.10
CM_ROTATE_ARCHIVE_COUNT=2
CM_RESYNC_INTERVAL_SEC=600
CM_DEDUP_WINDOW=100

# A live Binance submit requires complete Order and Trade reconciliations from
# the dedicated cache process within this age. It comfortably exceeds the
# 180-second Trade polling interval while retaining a bounded fail-closed window.
CM_BINANCE_ACCOUNT_CACHE_MAX_AGE_SEC=600
# A pre-cancel cache authorization is single-use and must reach the exact immediate
# replacement submit within this bounded in-process interval.
CM_BINANCE_ACCOUNT_CACHE_PERMIT_TTL_SEC=60
# On-demand REST quotes may be reused only inside this short, explicit interval.
# A failed refresh never extends the lifetime of an older quote.
CM_BINANCE_REST_PRICE_CACHE_TTL_SEC=11
CM_LONG_ARCHIVE_MONTHS=12
CM_LONG_ARCHIVE_SAMPLE_SEC=0.8
CM_LONG_ARCHIVE_FLUSH_SEC=60
CM_LONG_ARCHIVE_MEMORY_ROWS=10000
# Mandatory, versioned policy for application log volume and write batching.
LOG_MAX_FOLDER_BYTES=10737418240
LOG_CHECK_EVERY_WRITES=100
LOG_MIN_FREE_PERCENT=5
LOG_FLUSH_EVERY_RECORDS=64
LOG_FLUSH_INTERVAL_SEC=1
LOG_COMPRESS_AFTER_DAYS=3
LOG_DELETE_AFTER_DAYS=45
LOGROTATE_MAX_SIZE=20M
LOGROTATE_KEEP=3
# Mandatory, versioned global MonitorTrades configuration. Contains no secrets.
# Per-instrument policy remains in monitortrades.conf and instruments.conf.
MT_ARE_CLOSE_TOLERANCE_PCT=1.0
MT_RECENT_TRADE_BLOCK_HOURS=3
MT_ALL_TRADES_BLOCK_HOURS=1
MT_MAIN_LOOP_SLEEP_SEC=48
MT_BUY_PRICE_OFFSET=0.5
MT_SELL_SAFEBACK_HOURS=2
MT_BUY_SAFEBACK_HOURS=48
MT_GUARD_WINDOW_DAYS=12
# ============================================================================
# Persistent failed-order retry queue. This versioned configuration contains no secrets
# and is loaded by order_retry.py during import.
#
# A placement intent is stored before submit. One worker recovers ambiguous submits,
# retries eligible pending work, then retains accepted venue orders until terminal
# reconciliation. Open and partial orders are observed, never resubmitted.
#
# This mechanism cannot prove that the originating strategy signal remains valid. Price,
# profit, anti-spam, trend, and cooldown checks are not substitutes for strategy-intent
# validation. It is enabled by explicit operator decision with durable lease and venue
# client-order-id reconciliation.
# ============================================================================

# Enabled by operator decision: failed placements enter the durable leased outbox.
# The shared price/profit/balance/trend/cooldown guards are re-evaluated at retry time,
# but the originating strategy signal itself is not reconstructed.
RETRY_ENABLED=true                # Kill switch; false disables enqueue and retry.
RETRY_INTERVAL_SEC=300            # Minimum five-minute interval between attempts.
RETRY_TTL_SEC=86400               # One active day; time deferred by trend is excluded.
RETRY_MAX_ATTEMPTS=0              # 0 means TTL-only; positive values cap attempts.

# Price gate: retry only at an equal or more favorable price within this tolerance.
# SELL requires current >= requested*(1-tol); BUY requires current <= requested*(1+tol).
RETRY_PRICE_TOL=0.002
# False preserves independent same-symbol/same-side intents from different modules.
# The queue-size bound remains the protection against uncontrolled growth.
RETRY_DEDUP=false
# Hard queue-size bound; 0 disables the bound. New records are refused at the limit.
RETRY_MAX_QUEUE=500
# A claimed record stays persisted and becomes eligible again after worker death.
RETRY_CLAIM_LEASE_SEC=120
# A venue NOT_FOUND response authorizes resubmission only within this age. The
# worker also applies the provider's explicit retention bound and uses the lower
# value. Thirty days stays well inside Binance's documented 90-day archive edge.
RETRY_NOT_FOUND_MAX_AGE_SEC=2592000
RETRY_WORKER_POLL_SEC=30
# Notification-only aggregation; never changes retry timing or intent expiry.
RETRY_GIVEUP_SUMMARY_SEC=900
# A venue-accepted claim gets a short bounded durability retry before a critical
# alert. Recovery remains reconciliation-only if every exact persistence attempt
# fails; it must never resubmit merely because tracking storage was unavailable.
ACCEPTED_TRACKING_PERSIST_ATTEMPTS=3
ACCEPTED_TRACKING_PERSIST_RETRY_DELAY_SEC=0.1

# RETRY_INTERVAL_SEC also bounds accepted-order status polling. Accepted trackers never
# expire from RETRY_TTL_SEC because that would lose real venue state. REJECTED/EXPIRED
# may retry only the unfilled remainder; CANCELED is alerted and not replayed.
# Mandatory, versioned PIA self-healing policy. Contains no secrets.
PIA_RESOLVED_CPU_THRESHOLD=40
PIA_RESOLVED_CPU_CONSECUTIVE=3
PIA_RESOLVED_CPU_SAMPLE_SEC=2
# Mandatory PriceAnalysis runtime configuration.
PRICEANALYSIS_DEBUG=false
PRICEANALYSIS_DRAW_MAX_POINTS=5000
# Mandatory, versioned RTrade policy. Contains no secrets.
# Missing or invalid values abort startup; source code has no policy defaults.
RTRADE_WAIT_FOR_ORDER_SEC=32
RTRADE_MIN_ADJUSTMENT_PCT=0.01
RTRADE_NOTIONAL_USDC=500
RTRADE_DEFAULT_ADJUSTMENT_PCT=0.0064
RTRADE_INITIAL_SPREAD_PCT=0.1
RTRADE_BUY_DECAY_PCT=0.005
RTRADE_SELL_DECAY_PCT=0.01
RTRADE_BUY_DESPERATE_HOURS_BASE=0.3
RTRADE_SELL_DESPERATE_HOURS_BASE=0.23
RTRADE_DESPERATE_SAFEBACK_SEC=3660
RTRADE_BUY_NORMAL_HOURS=16
RTRADE_SELL_NORMAL_HOURS=12
RTRADE_FOLLOWUP_OFFSET_PCT=0.01
RTRADE_FOLLOWUP_HOURS=2.7
RTRADE_BAD_DAY_TOLERANCE_PCT=0.1
RTRADE_BAD_DAY_MULTIPLIER=1.7
RTRADE_ZERO_EPSILON=0.0001
RTRADE_MAX_FAILURES=10
RTRADE_TREND_FILTER_ENABLED=true
RTRADE_TREND_FILTER_K=2.0
RTRADE_TREND_WINDOW_SEC=900
RTRADE_TREND_OHLC_FALLBACK_ENABLED=false
# off|shadow|live|emergency_only. 15 Sep -> 16 Sep was temporarily emergency_only (a
# possibly false drop must not stop us out; discretionary/adverse hard stops held instead
# of market-exiting, only a real loss >= RTRADE_EMERGENCY_HARD_STOP_PCT exited). Reverted
# to live on 16 Sep once the TAO regime settled: the adverse-regime market exit is active.
RTRADE_DYNAMIC_MARKET_EXIT_MODE=live
RTRADE_EMERGENCY_HARD_STOP_PCT=0.12
RTRADE_PAIR_COORDINATOR_ENABLED=true
RTRADE_PAIR_POLL_SEC=1
RTRADE_PAIR_MAX_ACTIVE_ROUNDS=4
RTRADE_PAIR_START_INTERVAL_SEC=8
RTRADE_PAIR_DIRECTIONS=BUY,SELL
RTRADE_INSUFFICIENT_FUNDS_BACKOFF_SEC=180
RTRADE_PLACE_FAILURE_BACKOFF_SEC=180
RTRADE_INTENT_MISSING_CONFIRMATIONS=2
RTRADE_INTENT_RECOVERY_HORIZON_SEC=300
RTRADE_FAST_FILL_RATIO=0.25
RTRADE_MIN_EDGE_PCT=0.0115
RTRADE_SHOCK_HARD_STOP_PCT=0.04
RTRADE_HARD_STOP_PCT=0.08
# Mandatory, versioned TradeAll policy. Contains no secrets.
# Missing or invalid values abort startup; source code has no policy defaults.
TRADEALL_TREND_OLD_HOURS=1.9
TRADEALL_PRICE_CHANGE_THRESHOLD_PCT=0.5180048459
TRADEALL_PRICE_CHANGE_THRESHOLD_BIG_PCT=2.4809130428
TRADEALL_TREND_MIN_VALIDATED_SEC=30
TRADEALL_TREND_MIN_VALIDATED_CONFIRMS=3
TRADEALL_TREND_CONSISTENT_CONFIRMS=24
TRADEALL_TREND_UNIFORM_RATE=0.08
TRADEALL_SLOPE_EXTREME_THRESHOLD=5.1
TRADEALL_FIRE_MAX_PER_TREND=3
TRADEALL_FIRE_MIN_RETRY_MINUTES=6
TRADEALL_FIRE_SAFEBACK_DAYS=14
# Symbol membership and per-symbol Kalman policy are defined only in instruments.conf.
